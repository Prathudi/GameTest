{
  "name": "corridor_wall_stops_right",
  "description": "Walking right along the top corridor stops at x=4, because (5,1) is a wall. Extra presses change nothing.",
  "timeout_ms": 15000,
  "steps": [
    { "action": "press", "key": "Enter" },
    { "action": "wait_for", "expect": { "scene": "playing" }, "timeout_ms": 2000 },
    { "action": "press", "keys": ["Right", "Right", "Right"] },
    { "action": "assert", "expect": { "player": { "x": 4, "y": 1 } } },
    { "action": "press", "key": "Right" },
    { "action": "assert", "expect": { "player": { "x": 4, "y": 1 } } },
    { "action": "press", "keys": ["Right", "Right"] },
    { "action": "assert", "expect": { "player": { "x": 4, "y": 1 } } }
  ]
}
