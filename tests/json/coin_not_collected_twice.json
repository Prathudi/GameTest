{
  "name": "coin_not_collected_twice",
  "description": "After taking the coin at (1,5), stepping away and back onto the same cell does not raise the score again.",
  "timeout_ms": 20000,
  "steps": [
    { "action": "press", "key": "Enter" },
    { "action": "wait_for", "expect": { "scene": "playing" }, "timeout_ms": 2000 },
    { "action": "press", "keys": ["Down", "Down", "Right", "Down", "Down", "Left"] },
    { "action": "assert", "expect": { "player": { "x": 1, "y": 5 }, "score": 1, "coins_remaining": 2 } },
    { "action": "press", "keys": ["Right", "Left"] },
    { "action": "assert", "expect": { "player": { "x": 1, "y": 5 }, "score": 1, "coins_remaining": 2 } }
  ]
}
