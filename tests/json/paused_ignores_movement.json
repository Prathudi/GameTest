{
  "name": "paused_ignores_movement",
  "description": "While paused, movement keys and Enter do nothing: the scene stays paused and the player stays put.",
  "timeout_ms": 15000,
  "steps": [
    { "action": "press", "key": "Enter" },
    { "action": "wait_for", "expect": { "scene": "playing" }, "timeout_ms": 2000 },
    { "action": "press", "key": "Escape" },
    { "action": "wait_for", "expect": { "scene": "paused" }, "timeout_ms": 2000 },
    { "action": "press", "keys": ["Right", "Down", "Left", "Up", "Enter"] },
    { "action": "assert", "expect": { "scene": "paused", "player": { "x": 1, "y": 1 }, "score": 0 } }
  ]
}
